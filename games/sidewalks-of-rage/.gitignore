# Server runtime state (file-based persistence; not source)
server/state.json
server/state.json.tmp

# Local env overrides (committed .env.development/.env.production hold only a public ws URL)
.env*.local

# Spec Kit working scratch (intermediate design notes; durable records live in specs/)
.specify/scratch/

# Claude Code / Spec Kit — ignore local + credential artifacts, keep skills tracked
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json
.claude/auth*.json
.specify/init-options.json
